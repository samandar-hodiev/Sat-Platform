# Web app configuration. Copy to web/.env.local.
#
# Only NEXT_PUBLIC_* values belong here: they are compiled into the JavaScript every visitor
# downloads. Backend secrets (DATABASE_URL, OAuth client secrets, AI keys) live in the root
# .env, which only the Go API reads.

# Origin of the Go API as the browser sees it (no trailing slash, no /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8090

# Google OAuth client ID of the *web* client (public by design; the API checks it against
# GOOGLE_CLIENT_IDS). Empty: the Google button says Google sign-in is not set up.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Public origin of this site for canonical URLs, Open Graph, sitemap.xml and robots.txt
# (no trailing slash). Empty: http://localhost:3000. Production must set it.
NEXT_PUBLIC_SITE_URL=

# Support address shown on /contact. Empty: the page says the address is coming soon.
NEXT_PUBLIC_SUPPORT_EMAIL=
