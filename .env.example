# Go API configuration. Copy to .env (git-ignored) and fill in the blanks.
# The API reads this file in development and test only; production injects real
# environment variables. The web app has its own public-only file: web/.env.example.

# --- Application ---------------------------------------------------------------
# development | test | production (production enforces https origins and JSON logs)
APP_ENV=development
# 8080 is taken by GitPulse on the developer machine, so the API uses 8090.
API_PORT=8090
APP_VERSION=dev
# debug | info | warn | error
LOG_LEVEL=info
# text (readable, development) | json (production)
LOG_FORMAT=text

# Public URL of the web app (used for links in emails and as the default CORS origin).
WEB_URL=http://localhost:3000

# --- PostgreSQL (single database for web, Android and iOS) ----------------------
# Required. Example for a local Postgres.app / Homebrew install:
#   postgres://<user>@localhost:5432/sat_platform?sslmode=disable
DATABASE_URL=
DATABASE_MAX_CONNS=10

# --- HTTP ------------------------------------------------------------------------
# Exact browser origins allowed to call the API, comma-separated. No "*".
# Defaults to WEB_URL. Production requires https:// origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxies/load balancers whose X-Forwarded-For is trusted (empty = none).
TRUSTED_PROXIES=
HTTP_MAX_BODY_BYTES=1048576
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s
# Default per-IP budget for /api/v1. Sign-in, codes and AI add stricter limits.
RATE_LIMIT_PER_MINUTE=300

# --- File storage ----------------------------------------------------------------
# local (development). S3-compatible storage is added before production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage

# --- Added by later sessions (not read yet) --------------------------------------
# GOOGLE_CLIENT_IDS=          # 1.01 — web, Android and iOS client IDs, comma-separated
# GOOGLE_CLIENT_SECRET=       # 1.01 — only if a server-side OAuth flow is used
# JWT_SECRET=                 # 1.01 — token signing key, 32+ random characters
# AI_PROVIDER_API_KEY=        # 3.12 — never exposed to the web or mobile apps
